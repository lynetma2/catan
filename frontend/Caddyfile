http://:80 {
    root * /srv

    @api {
        path /api /api/*
    }
    handle @api {
        reverse_proxy {$BACKEND_URL}
    }

    @ws {
        path /ws /ws/*
    }
    handle @ws {
        reverse_proxy {$BACKEND_URL}
    }

    handle {
        try_files {path} /index.html
        file_server
    }
}